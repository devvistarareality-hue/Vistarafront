#!/bin/sh
# Enabled automatically by `npm install` (package.json "prepare").
node scripts/check-inline-styles.js || exit 1
# An identifier used but never declared bundles fine and then throws on the
# device — this stands in for the linter the project does not have.
node scripts/check-undefined.js || exit 1
# A named import of something that is not exported is NOT a build error — it is
# `undefined` at runtime and throws on first use. Neither check above sees it.
node scripts/check-imports.js || exit 1
